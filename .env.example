# Required: JWT signing secret (generate a strong random string, e.g. `openssl rand -hex 32`)
SECRET_KEY=""

# Database: Supabase PostgreSQL Transaction/Session Pooler connection string
# Leave empty to use local SQLite (backend/db/database.db) for development.
# Example (Supabase Session Pooler - IPv4 compatible with Render):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL=""

# CORS: Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"
# Optional regex to also allow Vercel preview deployments:
# CORS_ORIGIN_REGEX="https://.*\.vercel\.app"

# Supabase Storage (optional, recommended for persistent graph image uploads in production)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="graph-images"

# Machine Learning (YOLOv8 + CNN/EasyOCR)
# Set ENABLE_LOCAL_ML="false" on Render Free (512 MB RAM) and set ML_SERVICE_URL
# to an external free ML host (e.g., Hugging Face Spaces Docker service).
ENABLE_LOCAL_ML="true"
ML_SERVICE_URL=""
ML_SERVICE_API_KEY=""
YOLO_MODEL_PATH="models/yolov8best.pt"
READER_TYPE="cnn"

# Operational settings
LOG_LEVEL="INFO"
DB_ECHO="false"
ENABLE_CSV_TIMINGS="false"
